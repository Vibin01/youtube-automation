# ==============================================================================
# AI YouTube Automation Agent - Environment Configuration
# ==============================================================================

# Google Gemini API
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# Database Configuration (SQLite)
DATABASE_URL="file:./dev.db"

# Google Cloud OAuth 2.0 (YouTube Data API v3 & YouTube Analytics API)
# Setup Instructions:
# 1. Go to Google Cloud Console: https://console.cloud.google.com/
# 2. Create a new project (e.g. "YouTube Automation Agent").
# 3. Enable APIs: "YouTube Data API v3" and "YouTube Analytics API".
# 4. Configure OAuth Consent Screen:
#    - User type: External
#    - Scopes:
#      - https://www.googleapis.com/auth/youtube.upload
#      - https://www.googleapis.com/auth/youtube.readonly
#      - https://www.googleapis.com/auth/yt-analytics.readonly
#    - Test users: Add your YouTube channel's Google email address.
# 5. Create Credentials -> OAuth client ID -> Web application:
#    - Authorized redirect URIs: http://localhost:3000/api/youtube/callback
# 6. Copy Client ID and Client Secret below:
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/youtube/callback"

# Local Output Directory (Absolute path or relative to project root)
OUTPUT_DIR="./output"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Custom FFmpeg path if not using bundled ffmpeg-static
# FFMPEG_PATH="C:\\ffmpeg\\bin\\ffmpeg.exe"
# FFPROBE_PATH="C:\\ffmpeg\\bin\\ffprobe.exe"
